        <!-- ===================== CHÚ THÍCH ===================== -->
        <mxCell id="legend" value="&lt;b&gt;Cách đọc&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; khóa chính (chữ đậm) · &lt;font color=&quot;#1D5EA8&quot;&gt;FK khóa ngoại (chữ xanh)&lt;/font&gt; · UQ không trùng · NULL được để trống&lt;br&gt;&lt;br&gt;&lt;b&gt;Đầu đường nối&lt;/b&gt;&lt;br&gt;Phía bảng cha (cột PK): gạch đôi = đúng một; vòng tròn + gạch = không hoặc một (FK được NULL)&lt;br&gt;Phía bảng con (cột FK): vòng tròn + chân gà = không, một hoặc nhiều&lt;br&gt;&lt;br&gt;&lt;b&gt;Màu đường&lt;/b&gt;&lt;br&gt;Đen: quan hệ nghiệp vụ&lt;br&gt;Xám: khóa ngoại về account (ai tạo, ai duyệt, ai được giao, ai đăng)&lt;br&gt;Xanh ngọc nét đứt: bảng notification (mới, chưa có trong file SQL v2)&lt;br&gt;&lt;br&gt;&lt;b&gt;Màu bảng&lt;/b&gt;&lt;br&gt;Xanh dương: tài khoản · Xanh lá: Topic · Vàng: phân công · Tím: tư liệu · Cam: bài viết, version · Đỏ: duyệt, góp ý · Xám: xuất bản&lt;br&gt;&lt;br&gt;&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;article.restored_from_version_id cố ý không có FK (tránh vòng khóa ngoại, kiểm tra ở R22)&lt;br&gt;publication: FK kép (article_id, version_id) tới article_version, version phải thuộc đúng bài&lt;br&gt;Ràng buộc liên bảng khác nằm ở view v_rule_violations (R01-R23)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=10;strokeColor=#999999;fillColor=#fafafa;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="600" height="300" as="geometry"/>
        </mxCell>

